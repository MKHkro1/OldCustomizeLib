<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <RootNamespace>CustomizeLib.BepInEx</RootNamespace>
    <!-- 这个工程名也叫 CustomizeLib.BepInEx，若不显式改 AssemblyName，它的产物会和主前置库
         BepInEx\CustomizeLib.BepInEx\CustomizeLib.BepInEx.dll 同名，再经 PostBuild 拷进 res\BepInEx
         时就会把主库整个覆盖掉（实测：res 里主库被换成 52KB 的 -re 版，public API 从 1025 个掉到 77 个）。
         作者发布时用的是 res\BepInEx\CustomizeLib.BepInEx_Re.dll，这里把 AssemblyName 对齐到该名字。 -->
    <AssemblyName>CustomizeLib.BepInEx_Re</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Patcher\BepInPriority.BepInEx\BepInPriority.BepInEx.csproj" />
  </ItemGroup>

</Project>
